{
  // Emitting build for the shipped library: flips tsconfig.json's noEmit and
  // trims maps; outDir/rootDir/declaration are inherited from tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationMap": false,
    "stripInternal": true,
    "sourceMap": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/__tests__/**",
    "src/testing/setup/**",
    "src/__type_probe.*",
    "src/cli/**"
  ]
}
