{
  "name": "@ablo/agent",
  "version": "0.59.0",
  "private": true,
  "description": "Internal AI SDK composition and Ablo coordination adapters for the product's agents.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./perception": {
      "source": "./src/perception/index.ts",
      "types": "./dist/perception/index.d.ts",
      "import": "./dist/perception/index.js",
      "default": "./src/perception/index.ts"
    },
    "./perception/ai-sdk": {
      "source": "./src/perception/ai-sdk/index.ts",
      "types": "./dist/perception/ai-sdk/index.d.ts",
      "import": "./dist/perception/ai-sdk/index.js",
      "default": "./src/perception/ai-sdk/index.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "agent",
    "ai-sdk",
    "coordination"
  ],
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "ai": "^6.0.0"
  },
  "dependencies": {
    "@abloatai/transaction": "file:../transaction"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@types/node": "^22.13.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.0.0",
    "ai": "^6.0.0"
  }
}
