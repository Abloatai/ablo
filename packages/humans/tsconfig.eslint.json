{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@abloatai/humans": ["./src/index.ts"],
      "@abloatai/humans/*": ["./src/*.ts"],
      "@abloatai/transaction": ["../transaction/src/index.ts"],
      "@abloatai/transaction/coordination": ["../transaction/src/coordination/index.ts"],
      "@abloatai/transaction/wire": ["../transaction/src/wire/index.ts"],
      "@abloatai/transaction/types": ["../transaction/src/types/index.ts"],
      "@abloatai/transaction/auth": ["../transaction/src/auth/index.ts"],
      "@abloatai/transaction/keys": ["../transaction/src/keys/index.ts"],
      "@abloatai/transaction/schema": ["../transaction/src/schema/index.ts"],
      "@abloatai/transaction/source": ["../transaction/src/source/index.ts"],
      "@abloatai/transaction/server": ["../transaction/src/server/index.ts"],
      "@abloatai/transaction/webhooks": ["../transaction/src/webhooks/index.ts"],
      "@abloatai/transaction/docs": ["../transaction/src/docs/index.ts"],
      "@abloatai/transaction/*": ["../transaction/src/*.ts"]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
