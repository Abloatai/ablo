{
  "name": "@abloatai/humans",
  "version": "0.57.0",
  "description": "The optional human-facing local-state package for Ablo: presence, live queries, and React bindings.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@ablo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "@ablo/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./react-runtime": {
      "@ablo/source": "./src/reactRuntime.ts",
      "types": "./dist/reactRuntime.d.ts",
      "import": "./dist/reactRuntime.js",
      "default": "./dist/reactRuntime.js"
    },
    "./plugin": {
      "@ablo/source": "./src/plugin.ts",
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./client": {
      "@ablo/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./surface": {
      "@ablo/source": "./src/surface.ts",
      "types": "./dist/surface.d.ts",
      "import": "./dist/surface.js",
      "default": "./dist/surface.js"
    },
    "./core": {
      "@ablo/source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/local/testing/**",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build && node ../ablo/scripts/strip-source-condition.mjs",
    "postpack": "node ../ablo/scripts/restore-source-condition.mjs",
    "pack:check": "node ../ablo/scripts/pack-check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=__tests__/unit",
    "test:contract": "jest --testPathPatterns=__tests__/contract",
    "test:property": "jest --testPathPatterns=__tests__/property",
    "test:migrated-integration": "jest --testPathPatterns=__tests__/integration",
    "test:e2e": "E2E_TEST=true jest --config jest.e2e.config.ts",
    "lint:eslint": "eslint . --cache",
    "check:boundary": "node scripts/check-boundary.mjs",
    "test:integration": "npm run build && node scripts/check-package-integration.mjs",
    "lint:pkg": "publint"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abloatai/ablo.git",
    "directory": "packages/humans"
  },
  "dependencies": {
    "@abloatai/transaction": "^0.57.0",
    "mobx": "^6.13.7",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^3.0.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "publint": "^0.3.17",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.4.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ws": "^8.18.3"
  }
}
