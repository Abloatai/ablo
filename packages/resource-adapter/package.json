{
  "name": "@ablo/resource-adapter",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@ablo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "linux/*.py",
    "runtime/Cargo.toml",
    "runtime/Cargo.lock",
    "runtime/src/*.rs",
    "scripts/build-runtime.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node ../ablo/scripts/strip-source-condition.mjs",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py' && node --conditions=@ablo/source --import tsx --test tests/gateway.ts",
    "typecheck": "tsc --noEmit",
    "test:linux": "node scripts/test-linux.mjs",
    "postpack": "node ../ablo/scripts/restore-source-condition.mjs",
    "pack:check": "node ../ablo/scripts/pack-check.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test:coordinator": "node --conditions=@ablo/source --import tsx --test tests/coordinator.ts"
  },
  "dependencies": {
    "@abloatai/transaction": "0.66.18"
  },
  "devDependencies": {
    "@ablo/tsconfig": "*",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "description": "Managed Linux filesystem and Git enforcement for Ablo resource claims.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abloatai/ablo.git",
    "directory": "packages/resource-adapter"
  }
}
