{
  "name": "@abloatai/cli",
  "version": "0.47.0",
  "description": "The ablo command line: set up Ablo, connect your database, and push your schema from the terminal.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "ablo": "./dist/cli.cjs"
  },
  "exports": {
    ".": "./dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup --config tsup.config.ts",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "jest",
    "test:quickstart": "node scripts/test-quickstart.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abloatai/ablo.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@abloatai/transaction": "^0.47.0",
    "jiti": "^2.7.0",
    "zod": "^4.4.3",
    "@abloatai/humans": "^0.47.0"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@jest/globals": "^30.2.0",
    "@prisma/client": "^7.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "drizzle-orm": "^0.45.2",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "picocolors": "^1.1.0",
    "postgres": "^3.4.0",
    "ts-jest": "^29.4.5",
    "ts-morph": "^26.0.0",
    "tsup": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
