{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js — for apps using the Next.js App Router (apps/web, ...).",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["dom", "dom.iterable", "es2024", "es2020", "es2021", "es2022"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "useDefineForClassFields": true,
    "plugins": [{ "name": "next" }]
  }
}
