{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library — emit declarations + sourcemaps, dist output, JSX support.",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "noEmit": false
  }
}
