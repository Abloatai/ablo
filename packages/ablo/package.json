{
  "name": "@abloatai/ablo",
  "version": "0.49.0",
  "description": "The public Ablo SDK for coordinated reads, commits, claims, observation, and reactive applications.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@ablo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "@ablo/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./react": {
      "@ablo/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./schema": {
      "@ablo/source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "default": "./dist/schema.js"
    },
    "./source": {
      "@ablo/source": "./src/source.ts",
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js",
      "default": "./dist/source.js"
    },
    "./source/next": {
      "@ablo/source": "./src/source-next.ts",
      "types": "./dist/source-next.d.ts",
      "import": "./dist/source-next.js",
      "default": "./dist/source-next.js"
    },
    "./source/drizzle": {
      "@ablo/source": "./src/source-drizzle.ts",
      "types": "./dist/source-drizzle.d.ts",
      "import": "./dist/source-drizzle.js",
      "default": "./dist/source-drizzle.js"
    },
    "./source/kysely": {
      "@ablo/source": "./src/source-kysely.ts",
      "types": "./dist/source-kysely.d.ts",
      "import": "./dist/source-kysely.js",
      "default": "./dist/source-kysely.js"
    },
    "./source/conformance": {
      "@ablo/source": "./src/source-conformance.ts",
      "types": "./dist/source-conformance.d.ts",
      "import": "./dist/source-conformance.js",
      "default": "./dist/source-conformance.js"
    },
    "./server": {
      "@ablo/source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./auth": {
      "@ablo/source": "./src/auth.ts",
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./coordination": {
      "@ablo/source": "./src/coordination.ts",
      "types": "./dist/coordination.d.ts",
      "import": "./dist/coordination.js",
      "default": "./dist/coordination.js"
    },
    "./ai-sdk": {
      "@ablo/source": "./src/ai-sdk.ts",
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "default": "./dist/ai-sdk.js"
    },
    "./wire": {
      "@ablo/source": "./src/wire.ts",
      "types": "./dist/wire.d.ts",
      "import": "./dist/wire.js",
      "default": "./dist/wire.js"
    }
  },
  "files": [
    "dist",
    "docs/*.md",
    "docs/examples",
    "docs/integrations",
    "examples",
    "assets",
    "AGENTS.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE",
    "NOTICE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build && node scripts/strip-source-condition.mjs",
    "postpack": "node scripts/restore-source-condition.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:errors": "tsx scripts/generate-error-docs.mts",
    "lint:errors": "tsx scripts/check-error-docs.mts",
    "generate:pricing": "tsx scripts/generate-pricing-docs.mts",
    "lint:pricing": "tsx scripts/check-pricing-docs.mts",
    "generate:openapi": "tsx --conditions=@ablo/source scripts/generate-openapi.mts",
    "lint:openapi": "tsx --conditions=@ablo/source scripts/generate-openapi.mts --check",
    "validate:openapi": "redocly lint ../../docs/ablo/public/openapi.json --extends=recommended --skip-rule=no-server-example.com",
    "build:docs": "node scripts/build-blume-docs.mjs",
    "lint:docs-site": "node scripts/build-blume-docs.mjs --check",
    "lint:docs": "node scripts/check-doc-drift.mjs",
    "lint:pkg": "publint"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abloatai/ablo.git",
    "directory": "packages/ablo"
  },
  "dependencies": {
    "@abloatai/humans": "^0.49.0",
    "@abloatai/transaction": "^0.49.0"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0",
    "react": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.2.8",
    "tsx": "^4.20.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.4"
  }
}
