{
  "name": "@abloatai/ablo",
  "version": "0.36.0",
  "description": "The Collaboration Layer For AI Agents",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ablo": "./bin/ablo.cjs"
  },
  "exports": {
    ".": {
      "@ablo/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "@ablo/source": "./src/schema/index.ts",
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./coordination": {
      "@ablo/source": "./src/coordination/index.ts",
      "types": "./dist/coordination/index.d.ts",
      "import": "./dist/coordination/index.js",
      "default": "./dist/coordination/index.js"
    },
    "./react": {
      "@ablo/source": "./src/react/index.ts",
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./core": {
      "@ablo/source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./batching": {
      "@ablo/source": "./src/batching/index.ts",
      "types": "./dist/batching/index.d.ts",
      "import": "./dist/batching/index.js",
      "default": "./dist/batching/index.js"
    },
    "./ai-sdk": {
      "@ablo/source": "./src/ai-sdk/index.ts",
      "types": "./dist/ai-sdk/index.d.ts",
      "import": "./dist/ai-sdk/index.js",
      "default": "./dist/ai-sdk/index.js"
    },
    "./source": {
      "@ablo/source": "./src/source/index.ts",
      "types": "./dist/source/index.d.ts",
      "import": "./dist/source/index.js",
      "default": "./dist/source/index.js"
    },
    "./source/conformance": {
      "@ablo/source": "./src/source/conformance.ts",
      "types": "./dist/source/conformance.d.ts",
      "import": "./dist/source/conformance.js",
      "default": "./dist/source/conformance.js"
    },
    "./source/drizzle": {
      "@ablo/source": "./src/source/adapters/drizzle.ts",
      "types": "./dist/source/adapters/drizzle.d.ts",
      "import": "./dist/source/adapters/drizzle.js",
      "default": "./dist/source/adapters/drizzle.js"
    },
    "./source/kysely": {
      "@ablo/source": "./src/source/adapters/kysely.ts",
      "types": "./dist/source/adapters/kysely.d.ts",
      "import": "./dist/source/adapters/kysely.js",
      "default": "./dist/source/adapters/kysely.js"
    },
    "./source/next": {
      "@ablo/source": "./src/source/next.ts",
      "types": "./dist/source/next.d.ts",
      "import": "./dist/source/next.js",
      "default": "./dist/source/next.js"
    },
    "./keys": {
      "@ablo/source": "./src/keys/index.ts",
      "types": "./dist/keys/index.d.ts",
      "import": "./dist/keys/index.js",
      "default": "./dist/keys/index.js"
    },
    "./auth": {
      "@ablo/source": "./src/auth/index.ts",
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./environment": {
      "@ablo/source": "./src/environment.ts",
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js",
      "default": "./dist/environment.js"
    },
    "./wire": {
      "@ablo/source": "./src/wire/index.ts",
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js",
      "default": "./dist/wire/index.js"
    },
    "./syncLog": {
      "@ablo/source": "./src/syncLog/index.ts",
      "types": "./dist/syncLog/index.d.ts",
      "import": "./dist/syncLog/index.js",
      "default": "./dist/syncLog/index.js"
    },
    "./server": {
      "@ablo/source": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./webhooks": {
      "@ablo/source": "./src/webhooks/index.ts",
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "default": "./dist/webhooks/index.js"
    },
    "./docs": {
      "@ablo/source": "./src/docs/index.ts",
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js",
      "default": "./dist/docs/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "!dist/__type_probe.*",
    "docs/*.md",
    "docs/examples/*.md",
    "examples",
    "AGENTS.md",
    "llms.txt",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "npm run typecheck:src && npm run typecheck:scripts",
    "typecheck:src": "tsc -p tsconfig.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "prepack": "node scripts/strip-source-condition.mjs",
    "postpack": "node scripts/restore-source-condition.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "lint": "npm run lint:imports && npm run lint:errors && npm run lint:openapi && npm run lint:docs && npm run lint:docs-site",
    "build:docs": "node scripts/build-blume-docs.mjs",
    "lint:docs-site": "node scripts/build-blume-docs.mjs --check",
    "lint:imports": "node scripts/check-js-extensions.mjs",
    "generate:errors": "tsx scripts/generate-error-docs.mts",
    "generate:openapi": "tsx --conditions=@ablo/source scripts/generate-openapi.mts",
    "lint:errors": "tsx scripts/check-error-docs.mts",
    "lint:openapi": "tsx --conditions=@ablo/source scripts/generate-openapi.mts --check",
    "lint:docs": "node scripts/check-doc-drift.mjs",
    "lint:eslint": "eslint . --cache",
    "lint:pkg": "publint",
    "prepublishOnly": "npm run build && npm run lint:pkg",
    "check:dist": "node scripts/check-dist-fresh.mjs",
    "pretest": "node scripts/check-dist-fresh.mjs",
    "test": "jest",
    "test:unit": "jest --testPathPatterns __tests__/unit",
    "test:integration": "jest --testPathPatterns __tests__/integration",
    "test:contract": "jest --testPathPatterns __tests__/contract",
    "test:property": "jest --testPathPatterns __tests__/property",
    "test:coverage": "jest --coverage",
    "test:e2e": "E2E_TEST=true jest --config jest.e2e.config.ts",
    "test:e2e:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:e2e:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e:run": "node scripts/run-e2e.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "state-management",
    "realtime",
    "multiplayer",
    "local-first",
    "collaborative",
    "agents",
    "ai",
    "commit",
    "intent",
    "api",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abloatai/ablo.git"
  },
  "homepage": "https://github.com/Abloatai/ablo#readme",
  "bugs": {
    "url": "https://github.com/Abloatai/ablo/issues"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "drizzle-orm": ">=0.44.0",
    "ai": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "dependencies": {
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.0.0",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "ai": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.0.0",
    "fast-check": "^3.0.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "publint": "^0.3.21",
    "ws": "^8.18.0"
  }
}
